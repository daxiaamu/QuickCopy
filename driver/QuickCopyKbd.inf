[Version]
Signature="$WINDOWS NT$"
Class=Keyboard
ClassGuid={4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=08/13/2026,1.0.0.0
CatalogFile=QuickCopyKbd.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
QuickCopyKbd.sys=1

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles
AddReg=KeyboardUpperFilter

[DefaultInstall.NTamd64.Services]
AddService=QuickCopyKbd,,DriverService

[DriverCopyFiles]
QuickCopyKbd.sys

[DriverService]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\QuickCopyKbd.sys

[KeyboardUpperFilter]
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E96B-E325-11CE-BFC1-08002BE10318}","UpperFilters",0x00010008,"QuickCopyKbd"

[Strings]
ProviderName="QuickCopy"
ServiceName="QuickCopy Keyboard Filter"
DiskName="QuickCopy Keyboard Filter Driver"
